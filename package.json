    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^3.19.0",
    "typescript": "^5.5.4",
    "tsx": "^4.19.1",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
