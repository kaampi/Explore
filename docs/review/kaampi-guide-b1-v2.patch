+    await view.until(() =>
+      expect(relevantSuggestions()).toEqual([
+        "Musikhuset",
+        "Dirigenten",
+        "Violinisten",
+        "Notstället",
+      ]),
+    );
+    await view.click("Stäng guiden");
+    await view.until(() => expect(view.host.textContent).toContain("Öppna guiden igen"));
+
+    const studio = new IndexedDBRepository(factory, "saved-guide-images");
